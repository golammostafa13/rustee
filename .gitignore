# --- Rust / Cargo build artifacts ---
# Every crate's build output. Regenerated by `cargo build`, so never commit it.
target/
# rust-analyzer's background `cargo check` output
**/flycheck*/
# Cargo's cached toolchain fingerprint (machine-specific paths)
.rustc_info.json

# Backtrace / panic dumps
*.pdb
# Coverage output
*.profraw
*.profdata

# --- Editor / OS noise ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~
.DS_Store
Thumbs.db

# --- Local env ---
.env
.env.local
